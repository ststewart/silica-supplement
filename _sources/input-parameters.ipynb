      "cst_liq_cross.rho = np.interp(cst_liquidus_P,cst_hug_liq.P,cst_hug_liq.rho)\n",
      "\n",
      "if 0: # do I need this anymore?\n",
      "    # -------  Coesite Hugoniot Model through melt curve -----------\n",
      "    # CST model Hugoniot\n",
      "    cst_tfit_liq =[   56.90163361,   208.76478146, -3572.92059707]\n",
      "    \n",
      "    # ODR quadratic solid region this work fit to solid EOS model\n",
      "    cst_tfit_stv =[  465.12905585, -7068.51146808, 30331.58709626] \n",
      "    cst_tfitcov_stv = [[ 2.72842368e+01, -4.82734776e+02,  2.12051066e+03],\\\n",
      "     [-4.82734776e+02,  8.55160232e+03, -3.76147499e+04],\\\n",
      "     [ 2.12051066e+03, -3.76147499e+04,  1.65690889e+05]]\n",
      "    \n",
      "    cst_hug_new = hp.HPeos_Shock()\n",
      "    cst_hug_new.rho_ref = 2.92 # g/cm3\n",
      "    cst_hug_new.up = np.arange(2.86,18,.01) # km/s\n",
      "    cst_hug_new.us = cst_fit_liq[1]+cst_fit_liq[0]*cst_hug_new.up # km/s\n",
      "    cst_hug_new.T = cst_tfit_liq[2] + (cst_tfit_liq[1]*(cst_hug_new.us))+ (cst_tfit_liq[0]*(cst_hug_new.us)*(cst_hug_new.us))\n",
      "    ind = np.where(cst_hug_new.up < cst_hug_cross.up)\n",
      "    cst_hug_new.us[ind] = cst_fit_cacl2[1]+cst_fit_cacl2[0]*cst_hug_new.up[ind] # km/s\n",
      "    cst_hug_new.T[ind] = cst_tfit_stv[2] + (cst_tfit_stv[1]*(cst_hug_new.us[ind]))+ (cst_tfit_stv[0]*(cst_hug_new.us[ind])*(cst_hug_new.us[ind]))\n",
      "    \n",
      "    \n",
      "    cst_hug_new.P = cst_hug_new.rho_ref*cst_hug_new.up*cst_hug_new.us\n",
      "    cst_hug_new.rho = 1./((1./cst_hug_new.rho_ref)*(1.-cst_hug_new.up/cst_hug_new.us))\n",
      "    cst_hug_new.U = 0.5*cst_hug_new.P*1.e9*((1/(1000*cst_hug_new.rho_ref))-(1/(1000*cst_hug_new.rho))) # J/kg\n",
      "    \n",
      "    # follow the melt curve region\n",
      "    ind = np.where((cst_hug_new.up > cst_sol_cross.up) & (cst_hug_new.up < cst_liq_cross.up))\n",
      "    cst_hug_new.T[ind] = np.interp(cst_hug_new.P[ind],stsmcsmooth.P,stsmcsmooth.T)\n",
      "\n",
      "\n",
      "# -------  Stishovite Hugoniot Liquid Region -----------\n",
      "\n",
      "# read in fit record\n",
      "stv_fit_liq0 = hp.HPeos_Fit()\n",
      "stv_fit_liq0.outputfitpath = modelfitpath # in load_paths.py\n",
      "stv_fit_liq0.filename = 'stv_fit_liq_linear_up18'\n",
      "stv_fit_liq0.loadjson()\n",
      "\n",
      "stv_hug_liq = hp.HPeos_Shock()\n",
      "stv_hug_liq.rho_ref = stv_fit_liq0.rho_ref # g/cm3\n",
      "stv_hug_liq.up = np.arange(5,20,.01) # km/s\n",
      "stv_hug_liq.us = stv_fit_liq0.calcf(stv_hug_liq.up)\n",
      "stv_hug_liq.calcPrho()\n",
      "\n",
      "stv_fitTus_liq0 = hp.HPeos_Fit()\n",
      "stv_fitTus_liq0.outputfitpath = modelfitpath # in load_paths.py\n",
      "stv_fitTus_liq0.filename = 'stv_fitTus_liq_fourthpoly'\n",
      "stv_fitTus_liq0.loadjson()\n",
      "stv_hug_liq.T = stv_fitTus_liq0.calcf(stv_hug_liq.us) # calculate temperatures on the solid branch Hugoniot\n",
      "\n",
      "# -------  Stishovite intersection points -----------\n",
      "\n",
      "# these are just based on the wiggles in the decaying shock from Millot et al. 2015\n",
      "stv_wiggle2 = hp.HPeos_Point()\n",
      "stv_wiggle2.us = 17.4 # km/s\n",
      "stv_wiggle2.P = np.interp(stv_wiggle2.us,stv_hug_liq.us,stv_hug_liq.P)\n",
      "stv_wiggle2.rho = np.interp(stv_wiggle2.us,stv_hug_liq.us,stv_hug_liq.rho)\n",
      "stv_wiggle2.up = np.interp(stv_wiggle2.us,stv_hug_liq.us,stv_hug_liq.up)\n",
      "stv_wiggle2.note = 'km/s, km/s, GPa, g/cm3'\n",
      "\n",
      "# new estimate of solidus, liquidus crossings May 2025\n",
      "# 580,670 estimated based on linear_up18 fit and shifted Gonzales et al. 2016 melt curve with conservative errors\n",
      "stv_liquidus_P = 670 # GPa\n",
      "stv_solidus_P = 585 # GPa\n",
      "\n",
      "#######################################################################################\n",
      "######  END OF FILE\n",
      "#######################################################################################\n",
