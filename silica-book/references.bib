@inproceedings{Ocampo2022,
  title={Melting and liquid phase response of silica shock compressed to 154 GPa: Hugoniot states and sound speed measurements},
  author={Ocampo, Ian Karl and Duffy, Thomas S and Winey, J Michael},
  booktitle={AGU Fall Meeting Abstracts},
  volume={2022},
  pages={DI45B--0038},
  year={2022},
  abstract={Flyer plate impact experiments using high impedance metal impactors (Cu, Pt, etc.) provide access to multi-megabar shock pressures in silicates. As much of the energy in the shock wave increases the entropy of the system, shock loading achieves concomitantly high pressures and temperatures. The pressure-temperature states accessed in shocked silicates are comparable to planetary adiabats and thus of direct geophysical importance. SiO2 is of particular interest because of its chemical abundance throughout the crust and mantle of the Earth and it is also likely a major constituent of other rocky planets. In the Earth, solid free silica is expected to play a role in cold subducting slabs of eclogitic/basaltic composition. For this reason, solid silica (fused silica, α-quartz, stishovite, etc.) has been extensively studied in both static and dynamic compression experiments. Although well understood in the solid state to extreme conditions, there is a gap in understanding the liquid response of silicates at lower mantle pressures. Although measurements of Hugoniot states provide important information regarding the pressure-density response of shock compressed materials, sound speed measurements provide an accurate determination of the shock melting pressure and, at higher pressures, of the Grüneisen parameter for the liquid phase. The Grüneisen parameter is a fundamental thermodynamic parameter that describes off-Hugoniot states (isentropic release, reshock, etc.) and can be used to accurately determine the temperature in a convecting, well mixed body such as an early Earth magma ocean. Using laser interferometry to measure wave profiles, we simultaneously determined the principal Hugoniot states and longitudinal sound speeds in fused silica (a pure silica glass with ) across the solid-liquid boundary and up to 154 GPa. We find that shock compressed fused silica transforms from the crystalline stishovite phase to a fully liquid phase at ~80 GPa. Our high precision Hugoniot and sound speed measurements provide the most precise determination of the Grüneisen parameter in liquid silica to date.}
}

@article{Wackerle1962,
abstract = {High explosive driving systems and high-speed optical techniques have been used to investigate the compressional behavior of x-cut, y-cut, and z-cut quartz crystals and fused quartz up to about 750 kbar pressure. In both forms of silica two-wave structures over a wide pressure range are identified as resulting from unusually high Hugoniot elastic limits. In crystalline quartz a dependence of the pressure of these elastic limits on driving shock pressure and sample thickness is associated with a relaxation-time phenomenon connected with the transition from elastic to fluid-like flow. Recovery experiments are reported which confirm a previous observation that sufficiently high shock pressures result in the transition of crystalline quartz to the fused state, and the implications of the compression data in this regard are discussed. Observations on fused quartz deomonstrate that shock-wave loading results in both the anomalous compression at low pressures and the compaction phenomena above 100 kbar which have been reported from hydrostatic experiments.},
author = {Wackerle, Jerry},
doi = {10.1063/1.1777192},
issn = {0021-8979},
journal = {Journal of Applied Physics},
mendeley-groups = {SiO2},
month = {mar},
number = {3},
pages = {922--937},
title = {{Shock-Wave Compression of Quartz}},
url = {http://aip.scitation.org/doi/10.1063/1.1777192 https://pubs.aip.org/jap/article/33/3/922/1993/Shock-Wave-Compression-of-Quartz},
volume = {33},
year = {1962}
}

