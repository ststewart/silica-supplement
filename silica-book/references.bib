@inproceedings{Ye2021,
  title={Temperature measurements of single crystal MgO shock-compressed up to 1.1 TPa and 33000 K},
  author={Ye, Zixuan and Smith, Ray and Millot, Marius and Hari, Anirudh and Singh, Saransh and Wicks, June},
  booktitle={AGU Fall Meeting Abstracts},
  volume={2021},
  pages={MR22A--08},
  year={2021},
  abstract={ With the discovery of exoplanets, knowledge of compositional minerals is necessary to determine the novel planetary interiors and their evolution. As a major component of terrestrial planets' interiors, Magnesium Oxide has attracted wide attention for its high-pressure behavior. Its simple B1 (NaCl-like) structure was measured to be stable in Earths mantle pressure and temperature range, while its transition to B2 (CsCl-like) structure is expected to occur at conditions of lower mantles of super-Earths (~400-600 GPa). Mantle viscosity is expected to decrease accompanied by B1-B2 phase transition, suggested by theoretical studies. While its high pressure and temperature properties are essential to model the interiors, the lack of constraints limits progress on these models. In this study, we measured the Hugoniot temperature of single-crystal MgO along different crystal orientations using the decaying shock compression technique, providing constraints on its phase diagram. We report the first investigation of the orientation effects on the phase transitions of shock-compressed MgO. The experiments were performed at the Omega-EP laser system at Rochester University. The shock wave velocity and thermal emission of the propagating shock front were measured using in-situ velocimetry and streaked optical pyrometry, respectively. We implemented an improved thermal emission model for semi-transparent materials and applied it to our measurements in order to better locate the phase boundaries and the Hugoniot temperatures. The temperature anomalies that are potentially associated with phase transitions indicate remarkably different Clapeyron Slope along 100, 110 crystalline orientations, where the transition kinetics and optical properties can potentially play an important role when performing uniaxial compression. In-situ X-ray diffraction data were measured in a wide range of pressures (300 to 600 GPa) to interpret our decaying shock compression results. This study will provide important insight into the orientation effect on phase transitions of geological minerals. (This work is funded by DOE under contract DE-FOA-0001891. Part of this work was prepared by LLNL under contract DE-AC52-07NA27344)}
}

